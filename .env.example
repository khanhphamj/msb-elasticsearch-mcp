# MCP server env (prefix MCP_). Local: `cp .env.example .env`. Deploy: pass via the runtime env file (`make deploy` reads ENV_FILE=.env.deploy), do NOT bake into the image.
MCP_APP_ENV=local
MCP_SERVER_NAME=sre-es
MCP_PORT=8080
# Public URL of the MCP endpoint = <runtime endpoint>/mcp (resource identifier RFC 9728)
MCP_RESOURCE_URL=http://localhost:8080/mcp

# none (local only — no token) | api_key | jwt
MCP_AUTH_MODE=none

# api_key: JSON list of SHA-256 hex. The raw key is stored in AgentBase Identity (API key provider) for the Gateway to send
#   uv run python -c "import secrets,hashlib;k=secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())"
MCP_API_KEY_SHA256=[]

# jwt: IdP issuing tokens (OAuth 2LO/3LO or inbound forward)
MCP_ISSUER=
MCP_JWKS_URL=
MCP_AUDIENCE=
MCP_USER_CLAIM=sub
# Scopes required for EVERY request (JSON list); per-tool scopes use require_scope() in server.py.
# api_key mode: these are also the scopes GRANTED to the key, so set ["logs.read","metrics.read"] or every tool is refused.
MCP_REQUIRED_SCOPES=[]

# Elasticsearch behind the tools. Use a READ-ONLY user limited to the two indices. Empty URL ⇒ tools say "not configured"
MCP_BACKEND_URL=
MCP_BACKEND_USERNAME=
MCP_BACKEND_PASSWORD=
# Alternative to username/password (sent as Bearer) — set one or the other
MCP_BACKEND_TOKEN=
MCP_BACKEND_TIMEOUT_S=10
MCP_LOGS_INDEX=logs-sample
MCP_METRICS_INDEX=metrics-sample
